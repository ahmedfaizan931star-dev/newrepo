# Local defaults. For online hosting, set these in the host's environment settings.
PORT=3000
NODE_ENV=development
ADMIN_USERNAME=your-unique-editor-name
ADMIN_PASSWORD=choose-a-unique-password-at-least-12-characters
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Optional: point to a persistent mounted directory on your host.
DATA_DIR=./data
# Optional: public canonical origin after deployment, e.g. https://your-domain.example
SITE_URL=
